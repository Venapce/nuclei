# Copy to .env.inflow and fill in from your platform's plugin provisioning.
# .env.inflow is gitignored — INFRA_CRED is a live credential.
PLUGIN_ID=
INFRA_CRED=
INFRA_URL=localhost:4222

# Optional: point nuclei at an isolated config/state directory so plugin state
# does not collide with a nuclei CLI on the same host.
# NUCLEI_CONFIG_DIR=./.nuclei
